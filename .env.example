# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Supabase: Project Settings > Database > Connection string).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/openmor"

# 32-byte AES-256-GCM key, base64-encoded, used to encrypt merchant Dodo API keys at rest.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Default Dodo Payments environment: test_mode (default) or live_mode.
# Live mode additionally requires an explicit per-merchant flag.
DODO_ENVIRONMENT="test_mode"

# Public base URL of this app, used to build checkout return URLs and buyer approval links.
APP_URL="http://localhost:3000"
