# Copy this file to .env and fill in real values. Never commit .env.

# Runtime Postgres connection used by the app. On Supabase, use the pooled
# "Transaction pooler" string (port 6543): Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Direct/session connection used only by the Prisma CLI for migrations (port 5432).
# On Supabase, use the "Session pooler" or "Direct connection" string.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# 32-byte AES-256-GCM key, base64-encoded, used to encrypt merchant Dodo API keys at rest.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored key unreadable.
ENCRYPTION_KEY=""

# Default Dodo Payments environment: test_mode (default) or live_mode.
# Live mode additionally requires an explicit per-merchant flag.
DODO_ENVIRONMENT="test_mode"

# Public base URL of this app, used to build checkout return URLs and buyer approval links.
# In production it must be https:// or the server refuses to start (see docs/deploy.md).
APP_URL="http://localhost:3000"

# Dodo Payments TEST-mode API key, used ONLY by local scripts such as `pnpm try:quote`.
# The app never reads it: merchant keys are pasted in the dashboard and stored encrypted.
DODO_TEST_API_KEY=""

# Resend API key, used to email buyers a one-time link to approve an agent's spending permission.
# Create one at https://resend.com/api-keys. Required in production.
RESEND_API_KEY=""

# Sender address for those emails. Leave empty to use Resend's test sender (onboarding@resend.dev),
# which can only deliver to your own Resend account address. To email real buyers, verify a domain
# at https://resend.com/domains and set e.g. "OpenMoR <approvals@yourdomain.com>".
EMAIL_FROM=""
